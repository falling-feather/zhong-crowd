{
  "name": "zhong-crowd-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/package-offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5186 --strictPort",
    "play": "node scripts/serve-release.mjs",
    "verify:campaign": "node scripts/audit-campaign.mjs",
    "test": "vitest run",
    "verify:exploration": "node scripts/audit-exploration.mjs",
    "verify:learning": "node scripts/audit-learning.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0"
}
